# ============================================================
#  Dashboard FBA — configuration
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  Guide pas à pas : docs/GUIDE-CONNEXION-AMAZON.md
# ============================================================

# --- Identifiants SP-API (Seller Central > Applications et services > Développer des applications)
SPAPI_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
SPAPI_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxx
SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxx

# Région SP-API : eu (Europe + UK), na (Amérique), fe (Japon, Australie...)
SPAPI_REGION=eu

# Marketplaces à suivre (codes pays séparés par des virgules)
# Disponibles : FR,DE,IT,ES,NL,BE,SE,PL,IE,UK
MARKETPLACES=FR,DE,IT,ES,NL,BE

# --- Fiscalité
# true  = vous êtes assujetti à la TVA (cas général) -> bénéfice calculé HT
# false = franchise en base / non assujetti -> TVA non récupérable, bénéfice calculé TTC
VAT_REGISTERED=true
# Taux de TVA appliqué aux frais Amazon si VAT_REGISTERED=false
FEES_VAT_RATE=20
# Surcharger les taux de TVA par pays (JSON, en %) — optionnel
# VAT_RATES={"FR":20,"DE":19}

# --- Devises : taux de conversion vers l'EUR pour les marketplaces hors zone euro
FX_RATES={"SEK":0.088,"PLN":0.234,"GBP":1.17}

# --- Calculs
# Part des unités remboursées qui reviennent en stock vendable (0 à 1) : leur coût d'achat est "récupéré"
RETURN_RESTOCK_RATE=0
# Si aucun historique ni estimation Amazon : frais estimés = ce % du prix TTC
FALLBACK_FEE_RATE=35

# --- Application
TIMEZONE=Europe/Paris
DATABASE_PATH=./data/dashboard.db
# Synchronisation automatique toutes les N minutes quand le serveur tourne (0 = désactivé)
SYNC_INTERVAL_MINUTES=15
# Historique récupéré lors de la toute première synchro (jours)
SYNC_INITIAL_DAYS=60
# Protège le dashboard par mot de passe (identifiant : n'importe lequel). Vide = pas de protection.
DASHBOARD_PASSWORD=
